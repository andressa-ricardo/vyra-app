{
  "expo": {
    "name": "VYRA",
    "slug": "vyra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vyraapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
