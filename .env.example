# Use o IPv4 do computador na rede local ao testar em um celular físico.
# O backend VYRA usa a porta 3000 por padrão. Não inclua /api/v1 aqui.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Google Sign-In (somente development build; não funciona no Expo Go).
# Client IDs OAuth são públicos. O ID token emitido terá como audience o client Web,
# então ele precisa estar em GOOGLE_OAUTH_CLIENT_IDS no backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Usado apenas no build iOS (config plugin): com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=

# Google Maps SDK for Android (react-native-maps), usado apenas no build Android.
# Restrinja a chave no Google Cloud ao package name e ao SHA-1 do app.
GOOGLE_MAPS_ANDROID_API_KEY=
